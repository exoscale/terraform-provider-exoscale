locals {
  zone = "{{ .Zone }}"
}

resource "exoscale_sks_cluster" "test" {
  zone           = local.zone
  name           = "terraform-provider-test-{{ .ID }}"
  description    = "description-test"
  exoscale_ccm   = true
  metrics_server = false
  auto_upgrade   = true
  labels = {
    test = "acctest"
  }
  feature_gates = ["GracefulNodeShutdown"]

  create_default_security_group = true

  timeouts {
    create = "10m"
  }
}

resource "exoscale_sks_nodepool" "test" {
  zone          = local.zone
  cluster_id    = exoscale_sks_cluster.test.id
  name          = "test"
  instance_type = "standard.small"
  disk_size     = 20
  size          = 1

  timeouts {
    delete = "10m"
  }
}

# Added in a second step (rather than alongside the resources above) so that
# Terraform refreshes exoscale_sks_cluster.test - and thus its "nodepools"
# attribute - after exoscale_sks_nodepool.test has been created.
data "exoscale_sks_cluster" "by_id" {
  zone = local.zone
  id   = exoscale_sks_cluster.test.id
}

data "exoscale_sks_cluster" "by_name" {
  zone = local.zone
  name = exoscale_sks_cluster.test.name
}
