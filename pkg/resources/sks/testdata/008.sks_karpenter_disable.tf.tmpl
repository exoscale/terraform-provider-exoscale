resource "exoscale_sks_cluster" "test-with-karpenter" {
  zone           = "{{ .Zone }}"
  name           = "terraform-provider-test-{{ .ID }}"
  description    = "description-test"
  exoscale_ccm   = true
  metrics_server = false
  auto_upgrade   = true
  labels = {
    test = "acctest"
  }

  # "0.0.0.0/0" keeps the API server reachable from the test harness.
  allowed_networks = ["0.0.0.0/0", "203.0.113.0/24"]

  enable_karpenter = false

  timeouts {
    create = "10m"
  }
}
