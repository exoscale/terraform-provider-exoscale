locals {
  zone = "{{ .Zone }}"
}

resource "exoscale_sks_cluster" "test" {
  zone = local.zone
  name = "terraform-provider-test-{{ .ID }}"

  timeouts {
    delete = "10m"
  }
}

resource "exoscale_sks_nodepool" "test" {
  zone          = local.zone
  cluster_id    = exoscale_sks_cluster.test.id
  name          = "terraform-provider-test-{{ .ID }}"
  description   = "description-test"
  instance_type = "standard.small"
  disk_size     = 20
  size          = 1
  labels = {
    test = "acctest"
  }

  timeouts {
    delete = "10m"
  }
}

# Added in a second step (rather than alongside the resource above) so that
# Terraform refreshes exoscale_sks_cluster.test - and thus its "nodepools"
# attribute - after exoscale_sks_nodepool.test has been created.
data "exoscale_sks_nodepool" "by_id" {
  zone       = local.zone
  cluster_id = exoscale_sks_cluster.test.id
  id         = exoscale_sks_nodepool.test.id
}

data "exoscale_sks_nodepool" "by_name" {
  zone       = local.zone
  cluster_id = exoscale_sks_cluster.test.id
  name       = exoscale_sks_nodepool.test.name
}
