resource "exoscale_domain" "test_domain" {
  name = "terraform-provider-test-{{ .ID }}.net"
}

resource "exoscale_domain_record" "test_mx" {
  domain      = exoscale_domain.test_domain.id
  name        = "mail1"
  record_type = "MX"
  content     = "mta1.terraform-provider-test-{{ .ID }}.net"
  prio        = 10
  ttl         = 10
}

resource "exoscale_domain_record" "test_txt" {
  domain      = exoscale_domain.test_domain.id
  name        = "test"
  record_type = "TXT"
  content     = "test value for TXT record"
}

data "exoscale_domain" "test_domain" {
  name = exoscale_domain.test_domain.name
}

data "exoscale_domain_record" "by_name" {
  domain = exoscale_domain.test_domain.name
  filter {
    name = exoscale_domain_record.test_mx.name
  }
}

data "exoscale_domain_record" "by_id" {
  domain = exoscale_domain.test_domain.name
  filter {
    id = exoscale_domain_record.test_mx.id
  }
}

data "exoscale_domain_record" "by_regex" {
  domain     = exoscale_domain.test_domain.name
  depends_on = [exoscale_domain_record.test_mx]
  filter {
    content_regex = "mta.*"
  }
}
